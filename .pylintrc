[FORMAT]
max-line-length=240
max-module-lines=1500

[TYPECHECK]
# These are not pip-installable (built alongside MOOSE) or are optional extras, so
# they are absent in CI / plain checkouts. Ignore them so lazy `import neml2` /
# `import pyzag` / `import torch_geometric` inside functions do not raise
# import-error. Their member checks (E1101) are already disabled above.
ignored-modules=neml2,pyzag,torch_geometric,mcp

[MESSAGES CONTROL]
# Base set follows the pyzag project standard: C0103 (invalid-name), E1101 (no-member),
# E1102 (not-callable; torch C-extension false positives), R0903 (too-few-public-methods),
# R0801 (duplicate-code).
# graintrace additions: the "too-many-*" complexity/design family is disabled because
# refactoring the numerical routines is deliberately out of scope; everything else
# (docstrings, import placement, unused names) is fixed in code, not silenced here.
disable=C0103,E1101,E1102,R0903,R0801,
        R0902,R0904,R0911,R0912,R0913,R0914,R0915,R0916,R0917,C0302

[DESIGN]
max-args=8
max-positional-arguments=8
max-attributes=12
max-locals=35
max-branches=30
max-statements=70
max-public-methods=25

[REFACTORING]
max-nested-blocks=6
