# Copy to deploy/env  (deploy/env is gitignored) and fill in.
#   cp deploy/env.example deploy/env && chmod 600 deploy/env
#
# Values here must be LITERAL: the systemd EnvironmentFile does not expand $HOME
# or %h inside values. Home-relative paths are handled in the units/scripts
# themselves (systemd uses the %h specifier; the tmux script uses $HOME).

# Shared secret that protects the mcpo tool endpoint (you invent this).
# Generate one:  openssl rand -hex 32
MCPO_API_KEY=change-me-openssl-rand-hex-32

# Bind ports (keep host on loopback; reach via SSH tunnel).
MCPO_PORT=8765
OPENWEBUI_PORT=8080
