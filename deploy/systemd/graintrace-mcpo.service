[Unit]
Description=graintrace MCP -> OpenAPI bridge (mcpo -> graintrace-mcp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Secret + ports. Create this file:  cp deploy/env ~/.config/graintrace-webui/env
EnvironmentFile=%h/.config/graintrace-webui/env
# NEPER / built binaries must be on PATH for the graintrace-mcp subprocess.
Environment=PATH=%h/miniconda3/envs/graintrace_env/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Env's newer libstdc++ (CXXABI) for neml2 AOTI / neml2-compile / puma-opt (CPFE).
Environment=LD_LIBRARY_PATH=%h/miniconda3/envs/graintrace_env/lib
Environment=GRAINTRACE_MCP_WORKDIR=%h/graintrace_mcp_out
ExecStart=%h/miniconda3/envs/graintrace_env/bin/mcpo \
  --host 127.0.0.1 --port ${MCPO_PORT} --api-key ${MCPO_API_KEY} \
  -- %h/miniconda3/envs/graintrace_env/bin/graintrace-mcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
