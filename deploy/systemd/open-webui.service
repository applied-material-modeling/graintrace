[Unit]
Description=Open WebUI (chat UI for graintrace via Argo + mcpo)
After=network-online.target graintrace-mcpo.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/graintrace-webui/env
Environment=PATH=%h/miniconda3/envs/openwebui/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATA_DIR=%h/.open-webui
ExecStart=%h/miniconda3/envs/openwebui/bin/open-webui serve \
  --host 127.0.0.1 --port ${OPENWEBUI_PORT}
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=default.target
